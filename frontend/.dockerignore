# Dependencies — reinstalled inside the image by npm ci
node_modules/

# Next.js build output — rebuilt inside the image
.next/
out/

# Environment files — injected at runtime, must not be baked into the image
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*

# OS / editor artefacts
.DS_Store
Thumbs.db
.vscode/
*.swp

# Git
.git/
.gitignore

# Docker files themselves
dockerfile
.dockerignore

# Tests / CI
coverage/